# Install inside nginx http{} (normally conf.d/). EXAMPLE ONLY; edit before use.
# Native ComfyUI should listen on 127.0.0.1:8188, NOT a public interface.
# The secret include contains: "Bearer <random-token>" 1;
# Store it root-owned, mode 0600, never in Git. This is proxy auth, not Comfy Cloud.
map $http_authorization $mj_comfy_authorized {
    default 0;
    include /etc/nginx/secrets/mj-comfy-tokens.map;
}
map "$request_method:$uri" $mj_comfy_route_allowed {
    default 0;
    ~^GET:/(system_stats|object_info|queue|history|view)$ 1;
    ~^GET:/history/[A-Za-z0-9_-]+$ 1;
    ~^POST:/(prompt|upload/image)$ 1;
}
server {
    listen 443 ssl;
    server_name gpu.example.com; # replace with actual dedicated hostname
    ssl_certificate /etc/letsencrypt/live/gpu.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gpu.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;
    allow 192.0.2.10; # documentation-only address: REPLACE with MJ worker egress IP
    deny all;
    if ($mj_comfy_authorized = 0) { return 401; }
    if ($mj_comfy_route_allowed = 0) { return 404; }
    location / {
        proxy_pass http://127.0.0.1:8188;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:8188;
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_next_upstream off; # Never retry an accepted generation POST elsewhere.
    }
}
